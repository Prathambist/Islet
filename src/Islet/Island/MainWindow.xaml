<Window x:Class="Islet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Islet"
        Title="Islet"
        Width="500"
        Height="400"
        Left="0"
        Top="0"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Chat app logos, drawn on the notification badge -->
        <StreamGeometry x:Key="DiscordLogo">M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z</StreamGeometry>
        <StreamGeometry x:Key="WhatsAppLogo">M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z</StreamGeometry>
        <StreamGeometry x:Key="MessengerLogo">M.001 11.639C.001 4.949 5.241 0 12.001 0S24 4.95 24 11.639c0 6.689-5.24 11.638-12 11.638-1.21 0-2.38-.16-3.47-.46a.96.96 0 00-.64.05l-2.39 1.05a.96.96 0 01-1.35-.85l-.07-2.14a.97.97 0 00-.32-.68A11.39 11.389 0 01.002 11.64zm8.32-2.19l-3.52 5.6c-.35.53.32 1.139.82.75l3.79-2.87c.25-.2.6-.2.86 0l2.8 2.1c.84.63 2.04.4 2.6-.48l3.52-5.6c.35-.53-.32-1.13-.82-.75l-3.79 2.87c-.25.2-.6.2-.86 0l-2.8-2.1a1.8 1.8 0 00-2.6.48z</StreamGeometry>

        <!-- Round, borderless icon button with a soft highlight and press squish -->
        <Style x:Key="IconButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Highlight"
                                     Fill="White"
                                     Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="0.86" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0.86" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill button in the timer section -->
        <Style x:Key="TimerChip" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill"
                                Background="#1FFFFFFF"
                                CornerRadius="15"
                                Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            The island is ONE black shape: no outline, no drop shadow (both used to
            show up as a box around the pill). Size, corner radius and clip are
            driven every frame by springs in code-behind; the content panels below
            have fixed sizes and are revealed by the shape instead of re-flowing.
        -->
        <Grid x:Name="IslandContainer"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="132,10,0,0"
              Width="236"
              Height="38"
              RenderTransformOrigin="0.5,0"
              MouseEnter="Island_MouseEnter"
              MouseLeave="Island_MouseLeave"
              MouseWheel="Island_MouseWheel"
              PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
              AllowDrop="True"
              DragEnter="Shelf_DragEnter"
              DragOver="Shelf_DragOver"
              DragLeave="Shelf_DragLeave"
              Drop="Shelf_Drop">

            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandScale"/>
                    <!-- Leans the island into the way it's dragged -->
                    <SkewTransform x:Name="IslandSkew"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Pick a colour…" Click="PickColor_Click"/>
                    <MenuItem Header="Settings…" Click="Settings_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit Islet" Click="Quit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <Border x:Name="IslandShape"
                    Background="Black"
                    CornerRadius="19"/>

            <Grid x:Name="IslandContent">

                <!-- Album-tinted glow behind the expanded card -->
                <Border x:Name="ExpandedGlow"
                        Opacity="0"
                        IsHitTestVisible="False"/>

                <!-- ===== Compact: music ===== -->
                <Grid x:Name="CompactMusic"
                      Width="236"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Border Width="24"
                            Height="24"
                            Margin="8,0,0,0"
                            CornerRadius="7"
                            Background="#1C1C1E"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,24,24" RadiusX="7" RadiusY="7"/>
                        </Border.Clip>
                        <Image x:Name="CompactAlbumArt"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel x:Name="CompactBars"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="0,0,14,0"/>

                    <local:TimerFace x:Name="CompactTimer"
                                     Form="Line"
                                     Width="120"
                                     Height="13"
                                     Margin="38,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Small: music, the size of the camera notch ===== -->
                <Grid x:Name="SmallMusic"
                      Width="112"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Border Width="20"
                            Height="20"
                            Margin="6,0,0,0"
                            CornerRadius="6"
                            Background="#1C1C1E"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,20,20" RadiusX="6" RadiusY="6"/>
                        </Border.Clip>
                        <Image x:Name="SmallAlbumArt"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel x:Name="SmallBars"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Height="16"
                                Margin="0,0,10,0"/>

                    <local:TimerFace x:Name="SmallTimer"
                                     Form="Stacked"
                                     Width="40"
                                     Height="20"
                                     Margin="30,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Mini: album art spinning in a small circle ===== -->
                <Grid x:Name="MiniMusic"
                      Width="38"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <!-- Cached so spinning only moves a texture instead of redrawing the art -->
                    <Grid Width="30"
                          Height="30"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.CacheMode>
                            <BitmapCache RenderAtScale="2"/>
                        </Grid.CacheMode>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="DiscRotate"/>
                        </Grid.RenderTransform>

                        <Ellipse Fill="#1C1C1E"/>
                        <TextBlock Text="&#xE8D6;"
                                   FontFamily="{StaticResource IconFont}"
                                   Foreground="#59FFFFFF"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Ellipse x:Name="DiscArt"/>
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="Black"
                                 Stroke="#40FFFFFF"
                                 StrokeThickness="0.5"/>
                    </Grid>

                    <local:TimerFace x:Name="DiscTimer"
                                     Form="Ring"
                                     Ticks="24"/>
                </Grid>

                <!-- ===== Mini: idle circle ===== -->
                <Grid x:Name="MiniIdle"
                      Width="30"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <local:TimerFace x:Name="OrbTimer"
                                     Form="RingWithTime"
                                     Ticks="24"/>

                    <Grid x:Name="OrbContent">
                    <Grid x:Name="OrbRingHolder"
                          Width="20"
                          Height="20"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.CacheMode>
                            <BitmapCache RenderAtScale="2"/>
                        </Grid.CacheMode>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="OrbRotate"/>
                        </Grid.RenderTransform>

                        <Ellipse x:Name="OrbRing"
                                 StrokeThickness="2"/>
                    </Grid>

                    <Ellipse x:Name="OrbDot"
                             Width="6"
                             Height="6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OrbDotScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Shrinks to fit inside the ring when the reading is long, like -12° -->
                    <Viewbox Width="20"
                             Height="12"
                             StretchDirection="DownOnly">
                        <TextBlock x:Name="OrbTemp"
                                   Foreground="White"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"/>
                    </Viewbox>
                    </Grid>
                </Grid>

                <!-- ===== Compact: clock / weather ===== -->
                <Grid x:Name="CompactAmbient"
                      Width="210"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <TextBlock x:Name="CompactTime"
                               Text="10:42"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                    <local:TimerFace x:Name="AmbientTimer"
                                     Form="Line"
                                     Width="130"
                                     Height="13"
                                     Margin="0,0,16,0"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"/>

                    <StackPanel x:Name="CompactAmbientInfo"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock x:Name="CompactAmbientGlyph"
                                   FontFamily="{StaticResource IconFont}"
                                   Foreground="#FFD60A"
                                   FontSize="13"
                                   Margin="0,1,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactAmbientText"
                                   Text="Wed 29"
                                   Foreground="#B3FFFFFF"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Compact: volume pill ===== -->
                <Grid x:Name="CompactVolume"
                      Width="264"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactVolumeGlyph"
                               Text="&#xE995;"
                               FontFamily="{StaticResource IconFont}"
                               Foreground="White"
                               FontSize="14"
                               Margin="16,0,10,0"
                               VerticalAlignment="Center"/>

                    <Grid x:Name="CompactVolumeTrack"
                          Grid.Column="1"
                          Height="5"
                          VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="2.5"/>
                        <Border x:Name="CompactVolumeFill"
                                Background="White"
                                CornerRadius="2.5"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Grid>

                    <TextBlock x:Name="CompactVolumeText"
                               Grid.Column="2"
                               Text="50"
                               Foreground="#B3FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Width="26"
                               TextAlignment="Right"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CompactDeviceName"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="CompactDeviceState"
                               Grid.Column="2"
                               Foreground="#B3FFFFFF"
                               FontSize="12"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- ===== Small: volume, brightness or device ===== -->
                <Grid x:Name="StatusSmall"
                      Width="150"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusSmallGlyph"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"/>

                    <Grid x:Name="StatusSmallTrack"
                          Grid.Column="1"
                          Height="4"
                          Margin="0,0,14,0"
                          VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="2"/>
                        <Border x:Name="StatusSmallFill"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Grid>

                    <TextBlock x:Name="StatusSmallName"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- ===== Circle: a ring that fills with the level ===== -->
                <Grid x:Name="StatusRing"
                      Width="38"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Ellipse Width="30"
                             Height="30"
                             Stroke="#33FFFFFF"
                             StrokeThickness="3"/>
                    <Ellipse x:Name="StatusRingFill"
                             Width="30"
                             Height="30"
                             StrokeThickness="3"
                             StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="StatusRingGlyph"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Camera notch (idle) ===== -->
                <Grid x:Name="NotchPanel"
                      Width="112"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Ellipse Width="11"
                             Height="11"
                             Margin="0,0,11,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#2A2F45" Offset="0"/>
                                <GradientStop Color="#10121C" Offset="0.6"/>
                                <GradientStop Color="#050508" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="2.5"
                             Height="2.5"
                             Margin="0,0,15.5,3"
                             Fill="#556A7BFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>

                    <local:TimerFace x:Name="NotchTimer"
                                     Form="Stacked"
                                     Width="64"
                                     Height="20"
                                     Margin="14,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Timer alone, when the island would otherwise be hidden ===== -->
                <Grid x:Name="TimerPill"
                      Width="112"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <local:TimerFace x:Name="PillTimer"
                                     Form="Stacked"
                                     Width="76"
                                     Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Peek: new song ===== -->
                <Grid x:Name="PeekMusic"
                      Width="340"
                      Height="64"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Margin="12,0,0,0"
                            CornerRadius="11"
                            Background="#1C1C1E"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PeekArtPop"/>
                        </Border.RenderTransform>
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,44,44" RadiusX="11" RadiusY="11"/>
                        </Border.Clip>
                        <Image x:Name="PeekArt"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel x:Name="PeekText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0,10,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PeekTextShift"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="PeekTitle"
                                   Foreground="White"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekArtist"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <local:TimerFace x:Name="PeekTimer"
                                     Grid.Column="2"
                                     Form="Stacked"
                                     Width="52"
                                     Height="22"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"/>

                    <StackPanel x:Name="PeekBars"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="0,0,20,0"/>
                </Grid>

                <!-- ===== Peek: chat message / update ===== -->
                <Grid x:Name="PeekNotify"
                      Width="370"
                      Height="76"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseLeftButtonUp="Notify_Click"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="44"
                          Height="44"
                          Margin="14,0,0,0">
                        <Border x:Name="NotifyBadge"
                                CornerRadius="12"
                                Background="#5865F2">
                            <TextBlock x:Name="NotifyBadgeGlyph"
                                       Text="&#xE8BD;"
                                       FontFamily="{StaticResource IconFont}"
                                       Foreground="White"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Path x:Name="NotifyLogo"
                              Width="26"
                              Height="26"
                              Fill="White"
                              Stretch="Uniform"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        <Border>
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,44,44" RadiusX="12" RadiusY="12"/>
                            </Border.Clip>
                            <Image x:Name="NotifyIcon"
                                   Stretch="UniformToFill"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0,20,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="now"
                                       Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="NotifyApp"
                                       Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <TextBlock x:Name="NotifySender"
                                   Foreground="White"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifyMessage"
                                   Foreground="#B3FFFFFF"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Shelf: files parked on the island ===== -->
                <Grid x:Name="ShelfPanel"
                      Width="380"
                      Height="136"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Grid x:Name="ShelfContent"
                          Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource TimerChip}"
                                    Height="24"
                                    Content="Clear"
                                    Click="ShelfClear_Click"/>
                            <Border x:Name="ShelfDragAll"
                                    DockPanel.Dock="Right"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#1FFFFFFF"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Cursor="SizeAll"
                                    ToolTip="Drag every file out at once"
                                    MouseLeftButtonDown="ShelfDragAll_MouseDown"
                                    MouseMove="ShelfDragAll_MouseMove">
                                <TextBlock Text="Drag all"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Shelf"
                                       Foreground="White"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ShelfCount"
                                       Style="{StaticResource Caption}"
                                       Margin="7,1,0,0"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer x:Name="ShelfScroller"
                                      Grid.Row="1"
                                      Margin="0,10,0,0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ShelfItems"
                                        Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- While a file is dragged over: where to let go -->
                    <!-- While a file is dragged over: keep it, or find out what has it open -->
                    <Grid x:Name="ShelfDropHint"
                          Margin="12"
                          Opacity="0"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ShelfZone">
                            <Rectangle x:Name="ShelfZoneOutline"
                                       RadiusX="16"
                                       RadiusY="16"
                                       Fill="#C70C0C0E"
                                       Stroke="#99FFFFFF"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="4 3"/>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="20"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Keep on the shelf"
                                           Foreground="White"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="LockZone"
                              Grid.Column="2">
                            <Rectangle x:Name="LockZoneOutline"
                                       RadiusX="16"
                                       RadiusY="16"
                                       Fill="#C70C0C0E"
                                       Stroke="#99FFFFFF"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="4 3"/>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="20"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="What's using it?"
                                           Foreground="White"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Colours picked lately ===== -->
                <Grid x:Name="PalettePanel"
                      Width="380"
                      Height="188"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Grid Margin="16,12,16,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource TimerChip}"
                                    Height="24"
                                    Content="Clear"
                                    Click="PaletteClear_Click"/>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource TimerChip}"
                                    Height="24"
                                    Margin="0,0,6,0"
                                    ToolTip="Pick a colour from the screen"
                                    Click="PalettePick_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEF3C;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Pick"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Colours"
                                       Foreground="White"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PaletteCount"
                                       Style="{StaticResource Caption}"
                                       Margin="7,1,0,0"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0">
                            <WrapPanel x:Name="PaletteSwatches"
                                       Width="348"/>
                            <TextBlock x:Name="PaletteNote"
                                       Style="{StaticResource Caption}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== What has a file open ===== -->
                <Grid x:Name="LocksPanel"
                      Width="380"
                      Height="400"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <StackPanel x:Name="LocksContent"
                                Margin="16,12,16,12"
                                VerticalAlignment="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource TimerChip}"
                                    Height="24"
                                    Margin="8,0,0,0"
                                    Content="Check again"
                                    Click="LocksRecheck_Click"/>
                            <TextBlock x:Name="LocksTitle"
                                       Foreground="White"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="LocksNote"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <StackPanel x:Name="LocksList"
                                    Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Expanded: music ===== -->
                <Grid x:Name="ExpandedMusic"
                      Width="400"
                      Height="172"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <!-- When no lyrics show: the cover, blurred and darkened, behind the card -->
                    <Grid x:Name="CoverBackdrop"
                          Visibility="Collapsed"
                          Opacity="0"
                          IsHitTestVisible="False">
                        <Image x:Name="CoverBackdropArt"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#73000000" Offset="0"/>
                                    <GradientStop Color="#A6000000" Offset="0.6"/>
                                    <GradientStop Color="#CC000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid Margin="22,20,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Art, title, live bars -->
                        <Grid>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HeaderShift"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="13"
                                    Background="#1C1C1E"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="AlbumArtPop"/>
                                </Border.RenderTransform>
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,56,56" RadiusX="13" RadiusY="13"/>
                                </Border.Clip>
                                <Grid>
                                    <TextBlock Text="&#xE8D6;"
                                               FontFamily="{StaticResource IconFont}"
                                               Foreground="#40FFFFFF"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image x:Name="AlbumArt"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,12,0">
                                <Border x:Name="TitleClip"
                                        ClipToBounds="True">
                                    <TextBlock x:Name="TrackTitle"
                                               Text="Not playing"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="TrackTitle_Click"
                                               ToolTip="Open album in Spotify">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="TitleTransform"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>

                                <TextBlock x:Name="TrackArtist"
                                           Text="Play something to get started"
                                           Foreground="#99FFFFFF"
                                           FontSize="13"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="TrackArtist_Click"
                                           ToolTip="Open artist in Spotify"/>
                            </StackPanel>

                            <StackPanel x:Name="ExpandedBars"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Height="26"/>
                        </Grid>

                        <!-- Current synced lyric line -->
                        <Border x:Name="LyricRow"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Height="20"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <TextBlock x:Name="LyricText"
                                       Foreground="#E6FFFFFF"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LyricShift"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>

                        <!-- High mode: the lyric lines, moved by hand each frame -->
                        <Canvas x:Name="LyricStage"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                Height="84"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="LyricStageShift"/>
                            </Canvas.RenderTransform>
                            <Canvas.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="0.2"/>
                                    <GradientStop Color="#FF000000" Offset="0.72"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Canvas.OpacityMask>
                        </Canvas>

                        <!-- Progress (drag to seek), or volume while scrolling -->
                        <Grid Grid.Row="2"
                              Margin="0,14,0,0"
                              Height="16">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ProgressShift"/>
                            </Grid.RenderTransform>

                            <Grid x:Name="ProgressRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedText"
                                           Text="0:00"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>

                                <Grid x:Name="ProgressTrack"
                                      Grid.Column="1"
                                      Height="16"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="Seek_MouseDown"
                                      MouseMove="Seek_MouseMove"
                                      MouseLeftButtonUp="Seek_MouseUp"
                                      LostMouseCapture="Seek_LostCapture">
                                    <Grid x:Name="ProgressBar"
                                          Height="5"
                                          VerticalAlignment="Center">
                                        <Border Background="#2EFFFFFF" CornerRadius="4"/>
                                        <Border x:Name="ProgressFill"
                                                Background="#E6FFFFFF"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                Width="0"/>
                                    </Grid>
                                </Grid>

                                <TextBlock x:Name="RemainingText"
                                           Grid.Column="2"
                                           Text="-0:00"
                                           Style="{StaticResource Caption}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid x:Name="VolumeRow"
                                  Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="VolumeRowGlyph"
                                           Text="&#xE995;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="#CCFFFFFF"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>

                                <Grid x:Name="VolumeTrack"
                                      Grid.Column="1"
                                      Height="5"
                                      VerticalAlignment="Center">
                                    <Border Background="#2EFFFFFF" CornerRadius="2.5"/>
                                    <Border x:Name="VolumeRowFill"
                                            Background="White"
                                            CornerRadius="2.5"
                                            HorizontalAlignment="Left"
                                            Width="0"/>
                                </Grid>

                                <TextBlock x:Name="VolumeRowText"
                                           Grid.Column="2"
                                           Text="50%"
                                           Style="{StaticResource Caption}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Controls -->
                        <Grid Grid.Row="3"
                              VerticalAlignment="Center"
                              Margin="0,6,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ControlsShift"/>
                            </Grid.RenderTransform>

                            <!-- Where the music comes from (shown when there's no heart) -->
                            <StackPanel x:Name="SourceLabel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        MaxWidth="58"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="SourceGlyph"
                                           Text="&#xE774;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="#8CFFFFFF"
                                           FontSize="12"
                                           Margin="0,1,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="SourceText"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid x:Name="HeartSlot"
                                  HorizontalAlignment="Left"
                                  Width="40"
                                  Height="40">
                                <Ellipse x:Name="HeartRing"
                                         Stroke="#FF375F"
                                         StrokeThickness="2"
                                         Opacity="0"
                                         IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="HeartRingScale"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Button x:Name="HeartButton"
                                        Style="{StaticResource IconButton}"
                                        Click="Heart_Click"
                                        ToolTip="Add to Liked Songs">
                                    <TextBlock x:Name="HeartGlyph"
                                               Text="&#xEB51;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="17"
                                               Foreground="#CCFFFFFF"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform x:Name="HeartScale"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Grid>
                                    <Button x:Name="ShuffleButton"
                                            Content="&#xE8B1;"
                                            Click="Shuffle_Click"
                                            Style="{StaticResource IconButton}"
                                            Width="34"
                                            Height="34"
                                            FontSize="14"
                                            Margin="0,0,4,0"
                                            ToolTip="Shuffle"/>
                                    <Ellipse x:Name="ShuffleDot"
                                             Width="3"
                                             Height="3"
                                             Fill="White"
                                             Margin="0,26,4,0"
                                             IsHitTestVisible="False"
                                             Visibility="Hidden"/>
                                </Grid>

                                <Button Content="&#xE892;"
                                        Click="Previous_Click"
                                        Style="{StaticResource IconButton}"
                                        FontSize="17"
                                        ToolTip="Previous"/>

                                <Button x:Name="PlayPauseButton"
                                        Content="&#xE768;"
                                        Click="PlayPause_Click"
                                        Style="{StaticResource IconButton}"
                                        Width="46"
                                        Height="46"
                                        FontSize="24"
                                        Margin="18,0"/>

                                <Button Content="&#xE893;"
                                        Click="Next_Click"
                                        Style="{StaticResource IconButton}"
                                        FontSize="17"
                                        ToolTip="Next"/>

                                <Grid>
                                    <Button x:Name="RepeatButton"
                                            Content="&#xE8EE;"
                                            Click="Repeat_Click"
                                            Style="{StaticResource IconButton}"
                                            Width="34"
                                            Height="34"
                                            FontSize="14"
                                            Margin="4,0,0,0"
                                            ToolTip="Repeat"/>
                                    <Ellipse x:Name="RepeatDot"
                                             Width="3"
                                             Height="3"
                                             Fill="White"
                                             Margin="4,26,0,0"
                                             IsHitTestVisible="False"
                                             Visibility="Hidden"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="&#xE916;"
                                        Click="TimerToggle_Click"
                                        Style="{StaticResource IconButton}"
                                        Foreground="#80FFFFFF"
                                        Width="28"
                                        FontSize="14"
                                        ToolTip="Timer"/>
                                <Button Content="&#xE713;"
                                        Click="Settings_Click"
                                        Style="{StaticResource IconButton}"
                                        Foreground="#80FFFFFF"
                                        Width="28"
                                        FontSize="15"
                                        ToolTip="Settings"/>
                            </StackPanel>
                        </Grid>

                        <local:TimerCard x:Name="MusicTimerCard"
                                         Grid.Row="4"/>
                    </Grid>
                </Grid>

                <!-- ===== Expanded: ambient (nothing playing) ===== -->
                <Grid x:Name="ExpandedAmbient"
                      Width="400"
                      Height="150"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Grid Margin="26,20,22,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AmbientTime"
                                       Text="10:42"
                                       Foreground="White"
                                       FontSize="40"
                                       FontWeight="Light"/>
                            <TextBlock x:Name="AmbientDate"
                                       Text="Wednesday, October 29"
                                       Foreground="#99FFFFFF"
                                       FontSize="13"
                                       Margin="2,-2,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="AmbientWeather"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock x:Name="AmbientWeatherGlyph"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="#FFD60A"
                                           FontSize="24"
                                           Margin="0,4,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AmbientTemp"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Light"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="AmbientWeatherText"
                                       Foreground="#99FFFFFF"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <DockPanel Grid.Row="1"
                                   LastChildFill="False">
                            <TextBlock Text="Nothing playing"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"/>

                            <Button DockPanel.Dock="Right"
                                    Content="&#xE713;"
                                    Click="Settings_Click"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#80FFFFFF"
                                    FontSize="14"
                                    Width="32"
                                    Height="32"
                                    ToolTip="Settings"/>

                            <Button DockPanel.Dock="Right"
                                    Content="&#xE916;"
                                    Click="TimerToggle_Click"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#80FFFFFF"
                                    FontSize="14"
                                    Width="32"
                                    Height="32"
                                    ToolTip="Timer"/>

                            <Button DockPanel.Dock="Right"
                                    Content="&#xEF3C;"
                                    Click="PickColor_Click"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#80FFFFFF"
                                    FontSize="14"
                                    Width="32"
                                    Height="32"
                                    ToolTip="Pick a colour from the screen"/>

                            <Button DockPanel.Dock="Right"
                                    Click="OpenSpotify_Click"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Margin="0,0,6,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Pill"
                                                Background="#1ED760"
                                                CornerRadius="14"
                                                Padding="14,6">
                                            <TextBlock Text="Open Spotify"
                                                       Foreground="Black"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="#3BE477"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <local:TimerCard x:Name="AmbientTimerCard"
                                         Grid.Row="2"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Sits over everything, and follows whatever shape the island has -->
            <local:GlyphOutline x:Name="AlertOutline"/>
        </Grid>

        <!--
            Files waiting on the shelf: a small black badge beside the island with how
            many. Clicking it, or dragging another file onto it, opens the shelf.
        -->
        <Border x:Name="ShelfPill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Height="22"
                CornerRadius="11"
                Background="Black"
                Padding="7,0,8,0"
                Cursor="Hand"
                Visibility="Collapsed"
                AllowDrop="True"
                ToolTip="Files on the shelf"
                MouseLeftButtonUp="ShelfPill_Click"
                DragEnter="Shelf_DragEnter"
                DragOver="Shelf_DragOver"
                DragLeave="Shelf_DragLeave"
                Drop="Shelf_Drop">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="11"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ShelfPillCount"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="5,0,0,1"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!--
            Colours picked lately: their dots, overlapping, in a small badge right of the
            island. Clicking it opens them all.
        -->
        <Border x:Name="ColorPill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Height="22"
                CornerRadius="11"
                Background="Black"
                Padding="6,0"
                Cursor="Hand"
                Visibility="Collapsed"
                ToolTip="Colours you picked"
                MouseLeftButtonUp="ColorPill_Click">
            <StackPanel x:Name="ColorPillDots"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"/>
        </Border>

        <!--
            Mic / camera in use, like iPhone's privacy dots: a small black bubble just
            beside the island (or in its place when the island is hidden). Hovering
            it says which apps underneath; clicking opens Windows' privacy settings.
        -->
        <Border x:Name="PrivacyPill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="18"
                Height="18"
                CornerRadius="9"
                Background="Black"
                Cursor="Hand"
                Visibility="Collapsed"
                MouseEnter="PrivacyPill_MouseEnter"
                MouseLeave="PrivacyPill_MouseLeave"
                MouseLeftButtonUp="PrivacyPill_Click">
            <Ellipse x:Name="PrivacyDot"
                     Width="7"
                     Height="7"
                     Fill="#FF9F0A"/>
        </Border>

        <Border x:Name="PrivacyLabel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="10"
                Background="Black"
                Padding="9,4"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                SizeChanged="PrivacyLabel_SizeChanged">
            <TextBlock x:Name="PrivacyText"
                       MaxWidth="300"
                       TextTrimming="CharacterEllipsis"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="Medium"/>
        </Border>
    </Grid>
</Window>
