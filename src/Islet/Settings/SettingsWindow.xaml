<Window x:Class="Islet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Islet Settings"
        Icon="/Assets/Islet.ico"
        Width="860"
        Height="660"
        MinWidth="700"
        MinHeight="480"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- One page in the sidebar -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control option -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Padding="12,5" Background="Transparent" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{DynamicResource Thumb}" CornerRadius="3" Width="6"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource ThumbHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderThickness="1" BorderBrush="{DynamicResource Divider}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource PillBg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="15" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal"
                                Margin="8,0,0,18">
                        <Image Source="/Assets/Islet.ico"
                               Width="30"
                               Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Islet"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="SidebarVersion"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search across every page -->
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="SearchBox"
                                 Padding="32,7,10,7"
                                 TextChanged="Search_Changed"/>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFaint}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint"
                                   Text="Find a setting"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFaint}"
                                   Margin="33,0,0,1"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <!-- The window's colours, one dot per palette -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="8,0,0,0">
                    <TextBlock Text="Palette"
                               FontSize="11"
                               Foreground="{DynamicResource TextFaint}"
                               Margin="0,0,0,8"/>
                    <StackPanel x:Name="PaletteDots"
                                Orientation="Horizontal"
                                Margin="-4,0,0,0"/>
                    <TextBlock x:Name="PaletteName"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,6,0,12"/>
                    <TextBlock Text="Changes save as you make them"
                               FontSize="11"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>

                <!-- The pages, with a highlight that glides to the chosen one -->
                <Grid>
                    <Border x:Name="NavHighlight"
                            Height="40"
                            CornerRadius="10"
                            Background="{DynamicResource AccentSoft}"
                            VerticalAlignment="Top">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavHighlightMove"/>
                        </Border.RenderTransform>
                        <Border Width="3"
                                Height="16"
                                CornerRadius="1.5"
                                Background="{DynamicResource Accent}"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0"/>
                    </Border>
                    <StackPanel x:Name="Nav"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== The chosen page ===== -->
        <ScrollViewer x:Name="Scroller"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <StackPanel x:Name="PageHost"
                        Margin="36,28,36,36"
                        MaxWidth="660">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="PageMove"/>
                </StackPanel.RenderTransform>

                <TextBlock x:Name="PageTitle"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PageBlurb"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,18"/>
                <ContentControl x:Name="PageContent"
                                Focusable="False"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
