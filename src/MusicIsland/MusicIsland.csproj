<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Overridden from the git tag by the release workflow; used by the updater -->
    <Version>1.1.0</Version>
    <!-- WinForms is used only for the system tray icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Shown on the exe and on every shortcut to it -->
    <ApplicationIcon>Assets\MusicIsland.ico</ApplicationIcon>
    <!-- A background widget: favour a small footprint over peak throughput -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF / WinForms type name clashes (Button, Application, Color, ...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MusicIsland.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>
</Project>
